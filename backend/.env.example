# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_VERSION=api/v1

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_URI=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URI=redis://<host>:<port>
REDIS_HOST=<redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=<min_64_char_secret>

# ── CORS / Cookies ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# ── Gmail OAuth2 (Nodemailer) ─────────────────────────────────────────────────
GMAIL_USER_EMAIL=<your_gmail_address>
GMAIL_CLIENT_ID=<google_oauth_client_id>
GMAIL_CLIENT_SECRET=<google_oauth_client_secret>
GMAIL_REFRESH_TOKEN=<google_oauth_refresh_token>
