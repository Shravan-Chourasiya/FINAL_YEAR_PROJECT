{
  "compilerOptions": {
    /* Environment */
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Path Aliases */
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    /* Strict Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    /* Module / Import Safety */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    /* Compatibility */
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}