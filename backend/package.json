{
  "name": "backend",
  "version": "1.0.0",
  "description": "SynthView AI backend — auth, sessions, real-time interview orchestration",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3",
    "http-status-codes": "^2.3.0",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "typescript": "6.0.3",
    "tsx": "^4.23.10",
    "eslint": "^10.8.1",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.67.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
